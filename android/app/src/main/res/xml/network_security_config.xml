<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        DESARROLLO: Permite HTTP para la IP del servidor local y el emulador.
        PRODUCCIÓN: Eliminar este archivo y usar HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- IP de la máquina donde corre el backend (cambiar según tu red) -->
        <domain includeSubdomains="true">192.168.1.3</domain>
        <!-- IP del host en el emulador de Android Studio -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- localhost para algunos emuladores -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
